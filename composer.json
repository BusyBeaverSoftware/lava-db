{
    "name": "lava/db",
    "description": "LavaPHP db pack — typed query builder, schema DSL, and migrations on PDO. Values are always parameter-bound.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "lava/core": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "Lava\\Db\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lava\\Db\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}